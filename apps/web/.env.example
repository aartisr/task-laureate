# Browser-safe Vite configuration. Copy to .env.local only for local development.
# Never put service-role keys, database passwords, VAPID private keys, or tokens
# beginning with sb_secret_ in this file or in any VITE_* variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-browser-safe-publishable-key
VITE_SUPABASE_WORKSPACE_ID=development

# Set only for deployments with the server-side Resend invite endpoint. It is
# intentionally omitted for plain Vite development, which uses manual copy.
VITE_INVITATION_DELIVERY_URL=/api/invitations

# List only providers already enabled in Supabase. Leave blank to show email sign-in only.
VITE_AUTH_PROVIDERS=
VITE_AUTH_PRIMARY_PROVIDERS=

# Optional browser-push public key. Generate once with `npm run generate:vapid`.
# The matching private key belongs only in Vercel's server-side environment.
VITE_VAPID_PUBLIC_KEY=
