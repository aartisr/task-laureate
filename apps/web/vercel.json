{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && npm ci --include=dev --include=optional",
  "buildCommand": "npm run verify:production && npm run build",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/cron/notifications", "schedule": "0 13 * * *" }
  ],
  "rewrites": [
    { "source": "/api/calendar/google/connect", "destination": "/api/calendar?route=google-connect" },
    { "source": "/api/calendar/google/callback", "destination": "/api/calendar?route=google-callback" },
    { "source": "/api/calendar/status", "destination": "/api/calendar?route=status" },
    { "source": "/api/calendar/task-block", "destination": "/api/calendar?route=task-block" },
    { "source": "/api/calendar/schedule", "destination": "/api/calendar?route=schedule" },
    { "source": "/api/calendar/sync", "destination": "/api/calendar?route=sync" },
    { "source": "/api/calendar/google/notifications", "destination": "/api/calendar?route=google-notification" },
    { "source": "/api/calendar/remove", "destination": "/api/calendar?route=remove" },
    { "source": "/api/calendar/disconnect", "destination": "/api/calendar?route=disconnect" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(lists-overview|lists|tasks|completed|progress|search|activity|settings|sign-in|auth)(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/icons/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml|manifest.json|llms.txt|og-image.svg|og-image-v2.png|favicon.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
