{
  "name": "Task-Laureate",
  "short_name": "Task-Laureate",
  "id": "/",
  "description": "A free, open-source, local-first task workspace for one clear next action.",
  "start_url": "/now",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0f172a",
  "theme_color": "#8b5cf6",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "utilities", "business"],
  "keywords": ["tasks", "productivity", "todo", "next action", "local-first", "open source"],
  "icons": [
    {
      "src": "/icons/task-laureate-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/task-laureate-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/task-laureate-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Capture",
      "short_name": "Capture",
      "description": "Capture a thought without leaving your flow",
      "url": "/capture",
      "icons": [{ "src": "/icons/task-laureate-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "All Tasks",
      "short_name": "Tasks",
      "description": "View and manage all your tasks",
      "url": "/tasks",
      "icons": [{ "src": "/icons/task-laureate-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Progress",
      "short_name": "Progress",
      "description": "View your progress analytics",
      "url": "/progress",
      "icons": [{ "src": "/icons/task-laureate-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Search across all lists and tasks",
      "url": "/search",
      "icons": [{ "src": "/icons/task-laureate-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/capture",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "related_applications": [],
  "prefer_related_applications": false
}
