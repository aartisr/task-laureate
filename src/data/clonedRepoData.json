                    "content": "{\n  \"schema_version\": \"v1\",\n  \"name_for_human\": \"Task-Laureate\",\n  \"name_for_model\": \"task_laureate\",\n  \"description_for_human\": \"A calm, private, open-source workspace for turning a crowded day into one clear next action.\",\n  \"description_for_model\": \"Task-Laureate is a free, open-source, privacy-minded, local-first task workspace for individuals. It supports quick capture, lists, priorities, due dates, tags, notes, attachments, dependencies, focused execution, progress review, search, export/import, and deliberate collaboration. Optional AI task decomposition is consent-controlled, editable, and never mutates tasks without human review. The canonical app is https://tasks.ai-aarti.com/ and the source is https://github.com/aartisr/task-laureate.\",\n  \"auth\": {\n    \"type\": \"none\"\n  },\n  \"api\": {\n    \"type\": \"openapi\",\n    \"url\": \"https://tasks.ai-aarti.com/openapi.yaml\"\n  },\n  \"logo_url\": \"https://tasks.ai-aarti.com/favicon.svg\",\n  \"contact_email\": \"aartisr@github.com\",\n  \"legal_info_url\": \"https://github.com/aartisr/task-laureate/blob/master/LICENSE\"\n}\n",
