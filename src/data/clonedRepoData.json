                    "content": "import { useState } from 'react'; import { deleteAntiBacklogData, exportAntiBacklogData } from '../core/privacy/antiBacklogData';\nexport function AntiBacklogPrivacyControls() { const [notice, setNotice] = useState(''); return <div className=\"button-row\"><button type=\"button\" className=\"secondary-button\" onClick={() => { const link = document.createElement('a'); link.href = URL.createObjectURL(new Blob([exportAntiBacklogData()], { type: 'application/json' })); link.download = 'task-laureate-anti-backlog.json'; link.click(); setNotice('Export downloaded.'); }}>Export planning data</button><button type=\"button\" className=\"secondary-button\" onClick={() => { deleteAntiBacklogData(); setNotice('Local planning data removed.'); }}>Delete planning data</button>{notice ? <p role=\"status\">{notice}</p> : null}</div>; }\n",
