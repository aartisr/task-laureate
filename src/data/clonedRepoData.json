            "content": "name: Publish GitHub Wiki\n\non:\n  push:\n    branches: [master]\n    paths:\n      - 'wiki/**'\n      - '.github/workflows/publish-wiki.yml'\n  workflow_dispatch:\n\npermissions:\n  contents: write\n\nconcurrency:\n  group: publish-wiki\n  cancel-in-progress: false\n\njobs:\n  publish:\n    name: Sync versioned Wiki source\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n\n      - name: Copy Wiki pages to GitHub Wiki repository\n        env:\n          WIKI_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n          WIKI_REPOSITORY: ${{ github.repository }}.wiki.git\n        run: |\n          wiki_directory=\"$(mktemp -d)\"\n          git clone \"https://x-access-token:${WIKI_TOKEN}@github.com/${WIKI_REPOSITORY}\" \"${wiki_directory}\"\n          cp wiki/*.md \"${wiki_directory}/\"\n          cd \"${wiki_directory}\"\n          git config user.name \"github-actions[bot]\"\n          git config user.email \"41898282+github-actions[bot]@users.noreply.github.com\"\n          git add --all\n          git diff --staged --quiet && exit 0\n          git commit -m \"docs: sync Task-Laureate Wiki\"\n          git push\n",
