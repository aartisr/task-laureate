            "type": "file",
            "language": "yaml",
            "content": "name: Apply Supabase migrations\n\non:\n  workflow_dispatch:\n    inputs:\n      confirmation:\n        description: Type APPLY to run pending migrations against the protected production project.\n        required: true\n        type: string\n\npermissions:\n  contents: read\n\njobs:\n  apply:\n    if: github.event.inputs.confirmation == 'APPLY'\n    name: Validate and apply protected production migrations\n    runs-on: ubuntu-latest\n    timeout-minutes: 20\n    # Configure required reviewers for this GitHub Environment. The workflow\n    # cannot contact production until that approval has been granted.\n    environment: production\n    env:\n      SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}\n      SUPABASE_PROJECT_REF: ${{ secrets.SUPABASE_PROJECT_REF }}\n      SUPABASE_DB_PASSWORD: ${{ secrets.SUPABASE_DB_PASSWORD }}\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 24\n          cache: npm\n      - uses: supabase/setup-cli@v1\n        with:\n          version: 2.110.0\n      - run: npm ci --include=dev --include=optional\n      - run: npm run verify:migrations\n      - name: Prove migrations replay and lint locally before production\n        run: |\n          supabase db start\n          supabase db reset --local --no-seed\n          supabase db lint --local --fail-on error\n      - name: Require the production migration credentials\n        run: |\n          test -n \"$SUPABASE_ACCESS_TOKEN\"\n          test -n \"$SUPABASE_PROJECT_REF\"\n          test -n \"$SUPABASE_DB_PASSWORD\"\n      - name: Link the protected production project\n        run: supabase link --project-ref \"$SUPABASE_PROJECT_REF\" --password \"$SUPABASE_DB_PASSWORD\"\n      - name: Apply pending migrations\n        run: supabase db push --linked --include-all\n      - name: Record the resulting migration state\n        run: supabase migration list --linked\n",
            "isModified": false
          },
