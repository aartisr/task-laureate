{
  "name": "laureate",
  "private": true,
  "version": "0.1.0",
  "description": "A generic, extensible TanStack task-management platform.",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "npm run test -w apps/web",
    "lint": "npm run lint -w apps/web",
    "check:perf-budgets": "npm run check:perf-budgets -w apps/web",
    "check:security": "npm audit --omit=dev --audit-level=high",
    "verify:migrations": "node scripts/verify-supabase-migrations.mjs",
    "quality:gate": "npm run verify:migrations && npm run verify:production && npm run lint && npm test && npm run build && npm run check:perf-budgets",
    "verify:public-registry": "node scripts/verify-public-registry.mjs",
    "verify:production": "npm run verify:public-registry && node scripts/verify-production-config.mjs",
    "generate:vapid": "node scripts/generate-vapid-keys.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs"
  },
  "devDependencies": {
    "supabase": "^2.110.0"
  }
}
