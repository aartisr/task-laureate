{
  "name": "@task-laureate/db",
  "version": "0.1.0",
  "description": "Database layer with Prisma ORM for Task-Laureate",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev --name init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "node dist/seed.js",
    "prisma:studio": "prisma studio",
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@prisma/client": "^5.13.0",
    "@prisma/instrumentation": "^5.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "prisma": "^5.13.0",
    "typescript": "^5.6.3"
  }
}
